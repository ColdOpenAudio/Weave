{
  "name": "weave",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:base": "node dist/index.js validate-base",
    "validate:preset": "node dist/index.js validate-preset"
  },
  "devDependencies": {
    "@types/node": "^25.0.8",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "ajv": "^8.12.0",
    "eslint": "^8.0.0",
    "prettier": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
